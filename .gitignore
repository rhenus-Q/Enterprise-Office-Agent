# ---- Environment / secrets ----
.env
.env.*
*.env
# keep the committed template un-ignored (no trailing comment: gitignore patterns are literal)
!.env.example
.envrc

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- Node / frontend ----
# The Vite frontend is npm-managed; its build output is covered by `dist/` below.
node_modules/
# Vite's dependency cache. It normally lives in node_modules/.vite (already covered
# above), but Vite falls back to a project-root .vite/ when node_modules is absent.
.vite/

# ---- Playwright (frontend responsive e2e) ----
# Generated report / artifact dirs; never committed. Browser binaries live in a
# global cache outside the repo, so they need no ignore here.
playwright-report/
blob-report/
test-results/
/frontend/playwright/.cache/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- uv ----
# Keep uv.lock committed for reproducible installs; ignore the local cache only.
.uv/

# ---- Test / tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
# Vitest coverage output (only produced when coverage is explicitly requested;
# the `npm test` script runs `vitest run` without it).
coverage/

# ---- Project data: persisted vector store ----
# Rebuilt locally via `uv run python -m enterprise_rag.ingestion`; do not commit.
chroma_db/

# ---- Local trace artifacts ----
# Explicit trace_path outputs can contain user-derived previews and hashes.
/traces/

# ---- Build artifacts ----
build/
dist/
*.egg-info/

# ---- IDE / editor ----
.vscode/
.idea/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Eval history records ----
# Generated at runtime — gitignored by default so history files do not bloat
# the repo. The directory itself is tracked via evals/enterprise_rag/history/.gitkeep.
# To share a specific baseline, force-add it:
#   git add -f evals/enterprise_rag/history/<file>.json
evals/enterprise_rag/history/*.json

# ---- Local planning / roadmap drafts ----
# docs/roadmap/ is a local working-artifact area (see docs/roadmap/README.md).
# Everything is ignored EXCEPT the README and the three workflow templates, which
# are tracked because .claude/commands/ files depend on them. Git cannot negate a
# path inside an excluded directory, so each tracked file needs its parent
# directory un-ignored and then re-ignored.
/docs/roadmap/*
!/docs/roadmap/README.md
!/docs/roadmap/spec/
/docs/roadmap/spec/*
!/docs/roadmap/spec/spec-template.md
!/docs/roadmap/plan/
/docs/roadmap/plan/*
!/docs/roadmap/plan/plan-template.md
!/docs/roadmap/implementation/
/docs/roadmap/implementation/*
!/docs/roadmap/implementation/implementation-template.md

#Internally modified documents
/Doc

# Generated Office-assist eval reports
/evals/office_agent/llm_assist/email_digest_results.md
/evals/office_agent/llm_assist/briefing_narrative_results.md

# Generated Enterprise RAG eval report
/evals/enterprise_rag/results.md

#old_claude_command
.claude/commands/old_command
