# ---- Environment / secrets ----
.env
.env.*
*.env
# keep the committed template un-ignored (no trailing comment: gitignore patterns are literal)
!.env.example
.envrc

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- uv ----
# Keep uv.lock committed for reproducible installs; ignore the local cache only.
.uv/

# ---- Test / tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Project data: persisted vector store ----
# Rebuilt locally via `uv run python -m enterprise_rag.ingestion`; do not commit.
chroma_db/

# ---- Build artifacts ----
build/
dist/
*.egg-info/

# ---- IDE / editor ----
.vscode/
.idea/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Eval history records ----
# Generated at runtime — gitignored by default so history files do not bloat
# the repo. The directory itself is tracked via evals/enterprise_rag/history/.gitkeep.
# To share a specific baseline, force-add it:
#   git add -f evals/enterprise_rag/history/<file>.json
evals/enterprise_rag/history/*.json

# ---- Local planning / roadmap drafts ----
/docs/roadmap
#Internally modified documents
/Doc

# Generated Office-assist eval reports
/evals/office_agent/llm_assist/email_digest_results.md
/evals/office_agent/llm_assist/briefing_narrative_results.md

# Generated Enterprise RAG eval report
/evals/enterprise_rag/results.md
