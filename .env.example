# Copy this file to .env and fill in your keys:
#   cp .env.example .env        (macOS / Linux)
#   Copy-Item .env.example .env (Windows PowerShell)

# --- Required ---

# OpenAI: used by the gpt-5-mini chat models (router, graders, generation)
# and by OpenAIEmbeddings (ingestion + retrieval).
OPENAI_API_KEY=sk-your-openai-key

# Tavily: used by the web-search fallback node.
TAVILY_API_KEY=tvly-your-tavily-key

# --- Optional ---

# Privacy / enterprise mode: set to false to disable ALL external web search.
# When false, user questions are never sent to Tavily; the assistant answers
# only from the local vector store and returns its deterministic
# insufficient-context response when the knowledge base can't answer.
# Default (unset or any other value): true.
# WEB_SEARCH_ENABLED=true

# Web-fallback policy: when web search is allowed, decides WHEN document
# grading falls back to the web (distinct from WEB_SEARCH_ENABLED, which is
# the hard privacy switch and overrides this policy entirely):
#   conservative (default) - generate from the remaining relevant local
#                            documents; web search only when none remain.
#   aggressive             - legacy CRAG behavior: any irrelevant retrieved
#                            document triggers web fallback before generation.
#   disabled               - local retrieval paths never escalate to the web
#                            (including the post-generation not-useful retry);
#                            router-chosen web searches still work.
# Invalid values fall back to conservative.
# WEB_FALLBACK_POLICY=conservative

# LangSmith tracing (recommended for debugging the self-correction loops).
# PRIVACY WARNING: enabling LangSmith sends prompts, user questions, retrieved
# document content, intermediate chain data, and model outputs to an external
# service (LangSmith). It is independent of WEB_SEARCH_ENABLED and is NOT
# disabled by privacy mode — leave it disabled in privacy-sensitive deployments.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2-your-langsmith-key
# LANGCHAIN_PROJECT=agentic-rag-assistant

# Per-run cost/latency budgets. Defaults (30 / 5 / 15) sit above the worst
# case the retry loop can produce, so they only bind if you tighten them.
# Invalid or non-positive values fall back to the defaults.
# MAX_LLM_CALLS_PER_RUN=30
# MAX_WEB_SEARCHES_PER_RUN=5
# MAX_WEB_RESULTS_TO_GRADE=15

# Per-request timeout (seconds) for a single LLM call. Bounds wall-clock time
# on one ChatOpenAI request so a hung dependency cannot stall a run; a timeout
# is mapped to the appropriate *_error stop_reason by existing handlers.
# Invalid or non-positive values fall back to the default.
# LLM_REQUEST_TIMEOUT_SECONDS=60

# Per-request timeout (seconds) for non-chat external calls — the OpenAI
# embeddings request behind the retriever (and the ingestion build). Bounds a
# hung embedding/retriever-style request so it cannot stall a run.
# Invalid or non-positive values fall back to the default.
# EXTERNAL_REQUEST_TIMEOUT_SECONDS=60

# --- Office Agent (optional LLM assists) ---

# Optional Office Agent LLM assists. When true, enables BOTH the Email Digest
# (Email Summary tool) and the Daily Briefing Narrative (Daily Briefing tool),
# in office_agent/llm_assist. Default OFF: only an explicit truthy value
# (true / 1 / yes / on) turns them on; with it unset or false both tools return
# their deterministic output and no LLM client is constructed. Each assist is a
# single, bounded, grounded call with no action surface — enabling this flag does
# NOT grant the Office Agent authority to send, approve, mutate, or execute any
# office operation; on any assist failure the deterministic output is preserved.
# Independent of the enterprise_rag WEB_SEARCH_ENABLED switch above.
# OFFICE_LLM_ENABLED=false

# Per-request timeout (seconds) for each single assist LLM call (both assists).
# Invalid or non-positive values fall back to the default.
# OFFICE_LLM_REQUEST_TIMEOUT_SECONDS=60
